# Supabase（必填）
SUPABASE_URL=https://pbxlnkbmzpqtacaxuqnk.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBieGxua2JtenBxdGFjYXh1cW5rIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njk1ODI0MDYsImV4cCI6MjA4NTE1ODQwNn0.GsM0MJFetC_OnrTs5p67iyZjktKCkntioqRyuo-d0ho
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 鉴权（smoke / auth/token 需要）
AUTH_TOKEN_SECRET=your-hs256-secret-at-least-32-chars
AUTH_CLIENT_ID=cmp
AUTH_CLIENT_SECRET=cmp-secret
# 可选：为 env M2M token 绑定一个企业（JWT 为 customer_m2m）。测 Integration / upstream-integrations 等 platform_admin 接口时请注释掉。
# AUTH_ENTERPRISE_ID=

# OIDC（生产环境 Bearer）：三项都设置则走 RS256+JWKS。未配置时 Fastify 中间件会用 AUTH_TOKEN_SECRET 校验 HS256 Bearer（iss=iot-cmp-api，与 auth/token、tools/gen_token.js 一致）
# OIDC_ISSUER=https://your-idp/realms/foo
# OIDC_AUDIENCE=cmp-api
# OIDC_JWKS_URL=https://your-idp/realms/foo/protocol/openid-connect/certs

# 管理端（可选，用于 admin 接口与完整 smoke）
ADMIN_API_KEY=your-admin-key

# 密码重置（POST /auth/forgot-password + /auth/reset-password）
# Portal 落地页基址（邮件链接 = 基址 + ?token=...）
PASSWORD_RESET_URL_BASE=http://127.0.0.1:5173/reset-password
# Token 有效期（分钟），默认 60
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
#
# 发信通道：MAIL_PROVIDER=auto|http|smtp|log（默认 auto：优先 HTTP，其次 SMTP，否则本地日志）
# MAIL_PROVIDER=auto
# 共用发件人（HTTP/SMTP 未单独指定时可用）
# MAIL_FROM="CMP <noreply@example.com>"
#
# --- HTTP API 发信（推荐对接 Resend / SendGrid / 自建网关）---
# MAIL_HTTP_URL=https://api.resend.com/emails
# MAIL_HTTP_FROM="CMP <noreply@example.com>"
# MAIL_HTTP_FORMAT=simple|resend|sendgrid   # 默认 simple：{to,from,subject,text,html}
# MAIL_HTTP_BEARER=re_xxxxxxxx              # Authorization: Bearer ...
# MAIL_HTTP_API_KEY=                        # 或走自定义 API Key 头
# MAIL_HTTP_API_KEY_HEADER=X-Api-Key
# MAIL_HTTP_EXTRA_HEADERS={"X-Tenant":"cmp"}
# MAIL_HTTP_TIMEOUT_MS=15000
#
# --- SMTP 发信 ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="CMP <noreply@example.com>"
#
# 本地无 HTTP/SMTP 时默认把邮件内容（含重置链接）打到服务端日志；生产请配置发信并将 MAIL_DEV_LOG=false
# MAIL_DEV_LOG=true

# 上游集成凭证加密（V1.1 必填：POST/PATCH upstream-integrations 含 apiSecret/webhookKey 时）
# 应用 master key，不是上游 API Key
INTEGRATION_SECRET_KEY=your-integration-master-key-at-least-32-chars

# 上游连接与入站 Webhook：通过 POST /v1/upstream-integrations 写入 DB（勿使用 WXZHONGGENG_* 业务 env）

# Smoke 扩展测试（可选，未设置则跳过相关用例）
# SMOKE_SIM_ICCID=8986...
# SMOKE_RESELLER_ADMIN_TOKEN=eyJ...
# SMOKE_SIM_MSISDN=...

# 可选：HTTP 监听端口（默认 3000；公网联调建议用不常用端口如 13080，并同步放行防火墙/安全组）
# PUBLIC_IP=your.public.ip
# PUBLIC_PROTO=http
PORT=13080

# Worker：自然月用量固化（usage_daily_summary → usage_monthly_summary）；默认每天 01:15 UTC 滚上月
# USAGE_MONTHLY_ROLLUP_CRON=15 1 * * *

# TEST_READY fallback when no MAIN + Commercial Terms (days); CT path uses package terms instead
# TEST_READY_DAYS_WITHOUT_MAIN_SUBSCRIPTION=30
# （旧名 TEST_PERIOD_DAYS 仍可作为别名读取，建议迁移到新变量名）

# Worker：ONE_TIME 订阅到期（expires_at）自动 ACTIVE → EXPIRED；默认每 10 分钟
# SUBSCRIPTION_ONE_TIME_EXPIRY_CRON=*/10 * * * *
# SUBSCRIPTION_ONE_TIME_EXPIRY_BATCH_LIMIT=100

