{
  "apiBaseUrl": "https://connect.expeditioniot.com",
  "auth": {
    "tokenEndpoint": "/sim-user-center/api/login",
    "tokenField": "data.token",
    "expireTimeField": "data.expireTime",
    "tokenExpirySeconds": 7200
  },
  "operations": {
    "activate": "Recover",
    "suspend": "Stop",
    "resume": "Recover",
    "deactivate": "Stop"
  },
  "capabilities": {
    "supportsFutureDatedChange": true,
    "supportsRealTimeUsage": true,
    "supportsWebhookNotification": true,
    "maxBatchSize": 100,
    "supportedOperations": [
      "ACTIVATE",
      "SUSPEND",
      "RESUME",
      "DEACTIVATE",
      "CHANGE_PLAN",
      "GET_USAGE",
      "SIM_STATUS_CHANGE"
    ]
  },
  "endpoints": {
    "getSimInfo": {
      "path": "/sim-card-sale/card/card-info/api/queryInfo",
      "method": "POST",
      "description": "Query single SIM card info (MSISDN, IMSI, ispType)"
    },
    "getSimStatus": {
      "path": "/sim-card-sale/card/card-info/api/queryCardStatus",
      "method": "POST",
      "description": "Query single SIM card status (status, state, activateTime)"
    },
    "healthCheck": {
      "path": "/sim-card-sale/card/card-info/api/queryPackageInfo",
      "method": "POST",
      "description": "Upstream readiness probe — list configured product packages",
      "requestBody": {}
    },
    "getSimInfoBatch": {
      "path": "/sim-card-sale/card/card-info/api/simCard",
      "method": "POST",
      "description": "Query bulk SIM card info"
    },
    "getSimInfoSync": {
      "path": "/sim-card-sale/card/card-info/api/simCardSync",
      "method": "POST",
      "description": "Paginated sync of SIM card info (non-real-time)"
    },
    "getSimCardStatus": {
      "path": "/sim-card-sale/card/card-info/api/queryCardStatus",
      "method": "POST",
      "description": "Query single SIM card status"
    },
    "getSimStatusBatch": {
      "path": "/sim-card-sale/card/card-info/api/queryStatusBatch",
      "method": "POST",
      "description": "Query bulk SIM card status"
    },
    "getSimFlow": {
      "path": "/sim-card-sale/card/card-info/api/queryFlow",
      "method": "POST",
      "description": "Query SIM subscription product code and usage"
    },
    "getSimFlowsBatch": {
      "path": "/sim-card-sale/card/card-info/api/queryFlowsBatch",
      "method": "POST",
      "description": "Query bulk SIM subscription product code and usage"
    },
    "getUsage": {
      "path": "/sim-card/card/card-info/api/queryCdrFlowByDate",
      "method": "POST",
      "description": "Query daily CDR usage for ICCIDs"
    },
    "getUsageByMonth": {
      "path": "/sim-card/card/card-info/api/queryCdrFlowByMonth",
      "method": "POST",
      "description": "Query monthly CDR usage for ICCIDs"
    },
    "queryPackageInfo": {
      "path": "/sim-card-sale/card/card-info/api/queryPackageInfo",
      "method": "POST",
      "description": "List upstream product packages"
    },
    "updateCardStatus": {
      "path": "/sim-card-sale/card/card-info/api/updateCardStatus",
      "method": "POST",
      "description": "Change single SIM card status"
    },
    "updateCardStatusBatch": {
      "path": "/sim-card-sale/card/card-info/api/updateCardStatusBatch",
      "method": "POST",
      "description": "Change bulk SIM card status"
    },
    "changePlan": {
      "path": "/sim-card/card/cardProductChange/api/modify",
      "method": "POST",
      "description": "Subscribe SIM to upstream product package"
    }
  }
}
